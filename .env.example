# Copie este arquivo para .env e preencha. Sem as chaves de integração o app roda em MODO DEMONSTRAÇÃO
# (vídeo simulado; HubSpot e WhatsApp ficam só registrados na tabela Integracao).

# Banco (Supabase → Project Settings → Database → Connection string)
# App: "Transaction pooler" (porta 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<projeto>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrações: "Session pooler" (porta 5432)
DIRECT_URL="postgresql://postgres.<projeto>:<SENHA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Assinatura da sessão da equipe (qualquer texto longo e aleatório)
SESSION_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Fuso das aulas
TZ_AULAS="America/Sao_Paulo"

# LiveKit (vídeo da sala de aula e do plantão) — https://cloud.livekit.io
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# HubSpot (presença e treinamentos na ficha do cliente) — token de app privado
HUBSPOT_TOKEN=""

# WhatsApp Business Cloud API (avisos de inscrição, lembrete e cancelamento)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Supabase Storage (vídeos e arquivos dos cursos). Sem a chave, o envio de arquivos fica desligado.
SUPABASE_URL="https://<projeto>.supabase.co"
SUPABASE_SECRET_KEY=""

# Endereço público do app (para links enviados por WhatsApp)
APP_URL="http://localhost:3000"

# Opcional (só desenvolvimento): fixar o relógio, ex. "2026-10-07T13:20"
RELOGIO=""

# Senha inicial das contas criadas pelo seed
SEED_SENHA_INICIAL=""

# SÓ DESENVOLVIMENTO: libera /api/dev/entrar?email=... para testes automatizados (nunca em produção)
DEV_LOGIN=""

# API de integração (RPA): hash SHA-256 da chave. Sem ele, a API responde 503. Ver docs/API.md
API_RPA_CHAVE_HASH=""

# Clonagem de voz (ElevenLabs). Chave só no servidor, nunca NEXT_PUBLIC_.
ELEVENLABS_API_KEY=""
# Gestores ou RH com acesso à aba Clonagem de voz, separados por vírgula
VOZ_ACESSO_EMAILS=""
