# Copie este arquivo para .env e preencha. Sem as chaves de integração o app roda em MODO DEMONSTRAÇÃO
# (vídeo simulado; HubSpot e WhatsApp ficam só registrados na tabela Integracao).

# Banco local (SQLite). Em produção: URL do Postgres do Supabase.
DATABASE_URL="file:./dev.db"

# Assinatura da sessão da equipe (qualquer texto longo e aleatório)
SESSION_SECRET="troque-por-um-texto-longo-e-aleatorio"

# Fuso das aulas
TZ_AULAS="America/Sao_Paulo"

# LiveKit (vídeo da sala de aula e do plantão) — https://cloud.livekit.io
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# HubSpot (presença e treinamentos na ficha do cliente) — token de app privado
HUBSPOT_TOKEN=""

# WhatsApp Business Cloud API (avisos de inscrição, lembrete e cancelamento)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Endereço público do app (para links enviados por WhatsApp)
APP_URL="http://localhost:3000"

# Opcional (só desenvolvimento): fixar o relógio, ex. "2026-10-07T13:20"
RELOGIO=""

# Senha inicial das contas criadas pelo seed
SEED_SENHA_INICIAL=""

# SÓ DESENVOLVIMENTO: libera /api/dev/entrar?email=... para testes automatizados (nunca em produção)
DEV_LOGIN=""
